{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "page-puilder": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/page-puilder",
      "sourceRoot": "projects/page-puilder/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/page-puilder/src/main.ts",
            "tsConfig": "projects/page-puilder/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/page-puilder/public"
              }
            ],
            "styles": [
              "projects/page-puilder/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "page-puilder:build:production"
            },
            "development": {
              "buildTarget": "page-puilder:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "preview": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/preview",
      "sourceRoot": "projects/preview/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/preview/src/main.ts",
            "tsConfig": "projects/preview/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/preview/public"
              }
            ],
            "styles": [
              "projects/preview/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/preview/src/environments/environment.ts",
                  "with": "projects/preview/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "preview:build:production"
            },
            "development": {
              "buildTarget": "preview:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "brandomize-ui-kit": {
      "projectType": "library",
      "root": "projects/brandomize-ui-kit",
      "sourceRoot": "projects/brandomize-ui-kit/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/brandomize-ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/brandomize-ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/brandomize-ui-kit/tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "d48bb1e5-940e-44b4-a72d-07257a727c0a"
  }
}
